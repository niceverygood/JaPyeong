{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd mobile && npm install",
  "buildCommand": "cd mobile && npm run build:web && cd .. && rm -rf web/app && mkdir -p web/app && cp -R mobile/dist/. web/app/",
  "outputDirectory": "web",
  "framework": null,
  "functions": {
    "api/index.py": { "includeFiles": "backend/src/**" }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "headers": [
    {
      "source": "/store-screenshots/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
