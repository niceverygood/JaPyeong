# ============================================================
# 자평(子平) 환경 변수 템플릿
# 복사: cp .env.example .env  (실제 값은 절대 커밋 금지)
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://japyeong:japyeong@localhost:5432/japyeong
REDIS_URL=redis://localhost:6379/0

# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL_STANDARD=claude-sonnet-4-6
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
ANTHROPIC_MODEL_DEEP=claude-opus-4-7

# ---- Embedding ----
VOYAGE_API_KEY=

# ---- PortOne (결제) ----
PORTONE_API_SECRET=
PORTONE_STORE_ID=

# ---- KakaoPay 정기결제 ----
KAKAO_CID=CT97630018
KAKAO_ADMIN_KEY=

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=30

# ---- PII 암호화 (출생정보 컬럼 암호화 키, 32바이트 base64) ----
PII_ENCRYPTION_KEY=

# ---- App ----
ENV=local
LOG_LEVEL=INFO
