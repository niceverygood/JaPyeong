{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "cwd": "backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "src.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "mobile",
      "cwd": "mobile",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "web-static",
      "cwd": "mobile/dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4700"],
      "port": 4700
    }
  ]
}
